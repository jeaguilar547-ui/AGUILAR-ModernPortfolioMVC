@model AGUILAR_ModernPortfolioMVC.Models.Project

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <a asp-action="Index" class="btn btn-secondary mb-4">&larr; Back to Table of Contents</a>
    
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.Thumbnail" class="img-fluid rounded shadow" alt="@Model.Title" />
        </div>
        <div class="col-md-6">
            <h1 class="fw-bold">@Model.Title</h1>
            <p class="text-muted">@Model.ShortDescription</p>
            <hr />
            <h5>Tech Stack:</h5>
            <div class="mb-3">
                @foreach (var tech in Model.TechStack)
                {
                    <span class="badge bg-primary me-1">@tech</span>
                }
            </div>
            <h5>Architecture Overview:</h5>
            <p>@Model.LongDescription</p>
            <a href="@Model.GithubUrl" target="_blank" class="btn btn-dark mt-2">View Source on GitHub</a>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-md-8">
            <h3>Discussion & Comments</h3>
            @if (Model.Comments.Count == 0)
            {
                <p class="text-muted">No comments yet. Be the first to leave feedback!</p>
            }
            else
            {
                @foreach (var comment in Model.Comments)
                {
                    <div class="card mb-3 p-3 shadow-sm border-0 bg-light">
                        <div class="d-flex justify-content-between">
                            <h6 class="fw-bold mb-1">@comment.Author</h6>
                            <small class="text-muted">@comment.Date</small>
                        </div>
                        <p class="mb-0">@comment.Text</p>
                    </div>
                }
            }

            <div class="card mt-4 p-4 shadow-sm border-0">
                <h5 class="mb-3">Leave a Comment</h5>
                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="author" class="form-label">Your Name</label>
                        <input type="text" class="form-control" id="author" name="author" required />
                    </div>
                    <div class="mb-3">
                        <label for="text" class="form-label">Comment</label>
                        <textarea class="form-control" id="text" name="text" rows="3" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Post Comment</button>
                </form>
            </div>
        </div>
    </div>
</div>