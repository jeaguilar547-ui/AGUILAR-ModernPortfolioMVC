@model IEnumerable<AGUILAR_ModernPortfolioMVC.Models.Project>

@{
    ViewData["Title"] = "Portfolio Table of Contents";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold">BSIT Student Portfolio</h1>
    <p class="lead text-muted">IT Elective Projects &bull; Table of Contents</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4 mt-3">
    @foreach (var project in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="@project.Thumbnail" class="card-img-top" alt="@project.Title" style="height: 200px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@project.Title</h5>
                    <p class="card-text text-muted">@project.ShortDescription</p>
                    <div class="mb-3">
                        @foreach (var tech in project.TechStack)
                        {
                            <span class="badge bg-secondary me-1">@tech</span>
                        }
                    </div>
                    <div class="mt-auto">
                        <a asp-action="Detail" asp-route-id="@project.Id" class="btn btn-outline-primary btn-sm">View Detail & Comments</a>
                        <a href="@project.GithubUrl" target="_blank" class="btn btn-dark btn-sm">GitHub Repo</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
